# Settings for TandemBridge. .env stays on this laptop and is never committed.
# No need to edit it by hand: npm run bridge -- set-key <NAME> [value] writes one setting
# (creating .env from this file), and secrets are typed hidden: npm run bridge -- set-key <NAME>

# --- Email (on) ---
CHANNEL_EMAIL=on
SMTP_USER=
# Google Account > Security > App passwords. Not the normal Gmail password.
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- WhatsApp (off until a number and an approved template exist) ---
CHANNEL_WHATSAPP=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Template with exactly one body variable, e.g. "TandemBridge: {{1}}"
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Backup (optional) ---
# A folder for database copies. A OneDrive or Google Drive folder keeps one off this laptop.
# Leave empty to turn backups off.
BACKUP_DIR=
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=14

# --- ntfy (free phone push; install the ntfy app and subscribe to your topic) ---
CHANNEL_NTFY=off
# Make a private topic name with: npm run bridge -- ntfy-topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Only for a self-hosted server or a reserved topic
NTFY_TOKEN=

# --- Telegram (free; blocked in some countries, including Pakistan) ---
CHANNEL_TELEGRAM=off
# From @BotFather. After messaging your bot once, run: npm run bridge -- telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CallMeBot (free WhatsApp to your own number; unofficial third-party service) ---
CHANNEL_CALLMEBOT=off
# Your number with country code, e.g. +923001234567. Get the key at callmebot.com.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Watching (optional) ---
# A terminal window that shows each step live opens when a step starts. off stops it.
# WATCH_WINDOW=on

# --- Token usage (optional) ---
# The usage level lives in bridge.profile.json ("limits": { "usage": "saver" | "balanced" | "max" }).
# These override it. Leave empty to follow the level.
CLAUDE_MODEL=
CLAUDE_EFFORT=
TANDEMBRIDGE_TASK_BUDGET=
TANDEMBRIDGE_WORKFLOW_BUDGET=
